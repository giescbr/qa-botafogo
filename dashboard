<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard — Controle de Qualidade de Temperatura</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --primary-dark: #1a237e;
    --primary: #3f51b5;
    --primary-light: #e8eaf6;
    --bg: #f0f2f5;
    --white: #ffffff;
    --green: #4caf50;
    --red: #f44336;
    --orange: #ff9800;
    --yellow-light: #fff3cd;
    --text: #212121;
    --text-light: #757575;
    --border: #e0e0e0;
    --shadow: 0 2px 12px rgba(0,0,0,0.08);
    --radius: 12px;
  }

  body {
    font-family: 'Segoe UI', system-ui, sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
  }

  .topbar {
    background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary) 100%);
    color: #fff;
    padding: 18px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 4px 20px rgba(26,35,126,0.3);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .topbar h1 { font-size: 1.35rem; font-weight: 700; letter-spacing: .3px; }
  .topbar h1 span { opacity: .75; font-weight: 400; }
  #periodBadge {
    background: rgba(255,255,255,0.18);
    border: 1px solid rgba(255,255,255,0.35);
    padding: 5px 14px;
    border-radius: 20px;
    font-size: .82rem;
    font-weight: 600;
    display: none;
  }

  .container { max-width: 1400px; margin: 0 auto; padding: 28px 24px; }

  .modal-overlay {
    display: none; position: fixed; inset: 0;
    background: rgba(0,0,0,0.55); z-index: 500;
    align-items: center; justify-content: center;
  }
  .modal-overlay.show { display: flex; }
  .modal {
    background: var(--white); border-radius: 16px;
    padding: 36px 32px; width: 360px; max-width: 95vw;
    box-shadow: 0 20px 60px rgba(0,0,0,0.25);
    animation: popIn .35s cubic-bezier(0.34,1.56,0.64,1);
    text-align: center;
  }
  @keyframes popIn {
    from { transform: scale(0.7); opacity: 0; }
    to   { transform: scale(1);   opacity: 1; }
  }
  .modal .lock-icon { font-size: 3rem; margin-bottom: 12px; animation: bounce .6s ease; }
  @keyframes bounce {
    0%,100% { transform: translateY(0); }
    50%      { transform: translateY(-8px); }
  }
  .modal h3 { font-size: 1.1rem; color: var(--primary-dark); margin-bottom: 6px; }
  .modal p  { font-size: .83rem; color: var(--text-light); margin-bottom: 18px; }
  .pw-wrap  { position: relative; margin-bottom: 12px; }
  .pw-wrap input {
    width: 100%; padding: 11px 44px 11px 14px;
    border: 2px solid var(--border); border-radius: 8px;
    font-size: .9rem; outline: none; transition: border .2s;
  }
  .pw-wrap input:focus { border-color: var(--primary); }
  .pw-toggle {
    position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
    cursor: pointer; font-size: 1.1rem; user-select: none;
  }
  #modalError   { font-size: .8rem; color: var(--red); min-height: 18px; margin-bottom: 10px; font-weight: 600; }
  #lockdownMsg  {
    background: #fff3e0; border: 1px solid #ffcc02; border-radius: 8px;
    padding: 10px; font-size: .82rem; color: #e65100; display: none; margin-bottom: 12px;
  }
  .modal-actions  { display: flex; gap: 10px; justify-content: center; }
  .btn-outline {
    background: transparent; border: 2px solid var(--border);
    color: var(--text-light); padding: 9px 20px; border-radius: 8px;
    cursor: pointer; font-size: .875rem; font-weight: 600; transition: .2s;
  }
  .btn-outline:hover { border-color: var(--text-light); }
  .attempts-left { font-size: .78rem; color: var(--orange); margin-top: 8px; }

  #toast {
    position: fixed; bottom: 28px; right: 28px;
    padding: 13px 22px; border-radius: 10px;
    font-size: .875rem; font-weight: 600; color: #fff;
    box-shadow: 0 6px 24px rgba(0,0,0,0.18);
    z-index: 9999; display: none;
    animation: slideIn .3s ease;
  }
  @keyframes slideIn {
    from { transform: translateY(20px); opacity: 0; }
    to   { transform: translateY(0);    opacity: 1; }
  }

  .btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 9px 20px; border-radius: 8px; border: none;
    cursor: pointer; font-size: .875rem; font-weight: 600; transition: all .2s;
  }
  .btn-primary { background: var(--primary); color: #fff; }
  .btn-primary:hover { background: var(--primary-dark); transform: translateY(-1px); }
  .btn-sm { padding: 6px 14px; font-size: .8rem; }

  #emptyState {
    text-align: center; padding: 70px 20px;
    background: var(--white); border-radius: var(--radius); box-shadow: var(--shadow);
    margin-bottom: 28px;
  }
  #emptyState .es-icon { font-size: 4.5rem; margin-bottom: 16px; }
  #emptyState h3 { font-size: 1.25rem; color: var(--primary-dark); margin-bottom: 10px; }
  #emptyState p  { color: var(--text-light); font-size: .875rem; max-width: 380px; margin: 0 auto 20px; }
  #emptyState .es-arrow {
    font-size: 2rem; color: var(--primary); margin-top: 10px;
    animation: arrowBounce 1.2s ease-in-out infinite;
  }
  @keyframes arrowBounce {
    0%,100% { transform: translateY(0); }
    50%      { transform: translateY(8px); }
  }

  #dashboard { display: none; margin-bottom: 28px; }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 16px; margin-bottom: 24px;
  }
  .summary-card {
    background: var(--white); border-radius: var(--radius);
    box-shadow: var(--shadow); padding: 20px 18px;
    display: flex; flex-direction: column; gap: 4px;
    border-top: 4px solid var(--primary); transition: transform .2s;
  }
  .summary-card:hover { transform: translateY(-3px); }
  .summary-card .sc-label { font-size: .75rem; color: var(--text-light); font-weight: 600; text-transform: uppercase; letter-spacing: .5px; }
  .summary-card .sc-value { font-size: 2rem; font-weight: 800; color: var(--primary-dark); line-height: 1.1; }
  .summary-card .sc-sub   { font-size: .75rem; color: var(--text-light); }

  .section-title {
    font-size: .95rem; font-weight: 700; color: var(--primary-dark);
    margin-bottom: 14px; display: flex; align-items: center; gap: 8px;
  }

  .heatmap-card {
    background: var(--white); border-radius: var(--radius);
    box-shadow: var(--shadow); padding: 24px; margin-bottom: 24px;
  }
  .heatmap-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .heatmap-table  { border-collapse: collapse; min-width: 600px; width: 100%; font-size: .78rem; }
  .heatmap-table th {
    background: var(--primary-dark); color: #fff;
    padding: 8px 6px; text-align: center; white-space: nowrap; font-weight: 600;
  }
  .heatmap-table th.th-setor  { text-align: left; padding-left: 12px; min-width: 100px; }
  .heatmap-table th.th-periodo{ min-width: 90px; }
  .heatmap-table th.th-day    { min-width: 36px; }
  .heatmap-table tr.setor-header td {
    background: var(--yellow-light); font-weight: 800; color: var(--primary-dark);
    padding: 6px 10px; font-size: .82rem; letter-spacing: .4px; border-bottom: 1px solid #ffe082;
  }
  .heatmap-table tr.data-row td { padding: 5px 4px; text-align: center; border-bottom: 1px solid #f5f5f5; }
  .heatmap-table tr.data-row td.td-periodo {
    text-align: left; padding-left: 16px; color: var(--text-light); font-size: .77rem; white-space: nowrap;
  }
  .cell-ok    { background: #c8e6c9; color: #1b5e20; font-weight: 700; border-radius: 4px; }
  .cell-fail  { background: #ffcdd2; color: #b71c1c; font-weight: 700; border-radius: 4px; }
  .cell-empty { background: #f5f5f5; color: #bdbdbd; }
  .heatmap-legend { display: flex; gap: 20px; margin-top: 14px; flex-wrap: wrap; }
  .legend-item    { display: flex; align-items: center; gap: 6px; font-size: .78rem; color: var(--text-light); }
  .legend-dot     { width: 16px; height: 16px; border-radius: 4px; }

  .main-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 20px; margin-bottom: 24px;
  }
  @media (max-width: 860px) { .main-grid { grid-template-columns: 1fr; } }

  .card { background: var(--white); border-radius: var(--radius); box-shadow: var(--shadow); padding: 24px; }

  .sector-bar-item { margin-bottom: 14px; }
  .sector-bar-label {
    display: flex; justify-content: space-between;
    font-size: .82rem; font-weight: 600; margin-bottom: 5px;
  }
  .bar-track { height: 10px; background: #f0f0f0; border-radius: 6px; overflow: hidden; }
  .bar-fill  { height: 100%; border-radius: 6px; transition: width .6s ease; }

  .period-table { width: 100%; border-collapse: collapse; font-size: .83rem; margin-bottom: 16px; }
  .period-table th {
    background: var(--primary-light); color: var(--primary-dark);
    padding: 8px 12px; text-align: left; font-weight: 700;
  }
  .period-table td { padding: 9px 12px; border-bottom: 1px solid #f0f0f0; }
  .dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 6px; }

  .bottom-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px; }
  @media (max-width: 640px) { .bottom-grid { grid-template-columns: 1fr; } }

  .metric-badge {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 18px; border-radius: 30px;
    font-size: 1.4rem; font-weight: 800; margin: 10px 0;
  }
  .badge-green  { background: #e8f5e9; color: #2e7d32; }
  .badge-red    { background: #ffebee; color: #c62828; }
  .badge-orange { background: #fff8e1; color: #e65100; }
  .metric-desc  { font-size: .82rem; color: var(--text-light); line-height: 1.6; }
  .metric-stats { font-size: .82rem; color: var(--text); margin-bottom: 6px; }

  canvas { max-height: 220px; }

  .upload-section { margin-top: 8px; }
  .upload-card {
    background: var(--white); border-radius: var(--radius);
    box-shadow: var(--shadow); padding: 28px;
  }
  .upload-card-header {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 10px; margin-bottom: 20px;
  }
  .upload-card-header h2 { font-size: 1rem; color: var(--primary-dark); display: flex; align-items: center; gap: 8px; }
  .lock-badge {
    display: inline-flex; align-items: center; gap: 5px;
    background: #fff8e1; border: 1px solid #ffe082; color: #f57f17;
    font-size: .78rem; font-weight: 600; padding: 4px 10px; border-radius: 20px;
  }

  .drop-zone {
    border: 2.5px dashed var(--primary); border-radius: 10px;
    padding: 36px 20px; text-align: center; cursor: pointer;
    transition: all .25s; background: var(--primary-light); position: relative;
  }
  .drop-zone:hover, .drop-zone.dragover { background: #c5cae9; border-color: var(--primary-dark); }
  .drop-zone .dz-icon { font-size: 2.8rem; margin-bottom: 10px; }
  .drop-zone h3 { font-size: 1rem; color: var(--primary-dark); margin-bottom: 6px; }
  .drop-zone p  { font-size: .83rem; color: var(--text-light); margin-bottom: 14px; }
  #fileInput { display: none; }

  .file-badge {
    display: none; margin-top: 12px; padding: 8px 14px;
    background: #e8f5e9; border: 1px solid #a5d6a7; border-radius: 8px;
    font-size: .83rem; color: #2e7d32; font-weight: 600; align-items: center; gap: 6px;
  }
  .file-badge.show { display: inline-flex; }

  .instructions {
    margin-top: 20px; background: #f3f4ff;
    border-left: 4px solid var(--primary);
    border-radius: 0 8px 8px 0; padding: 16px 20px;
  }
  .instructions h4 { font-size: .9rem; color: var(--primary-dark); margin-bottom: 10px; }
  .instructions ul { list-style: none; font-size: .82rem; color: var(--text-light); line-height: 1.9; }
  .instructions ul li::before { content: '▸ '; color: var(--primary); }
  .instructions .aba-list { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .aba-chip {
    background: var(--primary-light); color: var(--primary-dark);
    font-size: .78rem; font-weight: 700; padding: 3px 10px; border-radius: 20px;
  }

  .section-divider {
    display: flex; align-items: center; gap: 14px;
    margin: 32px 0 24px; color: var(--text-light); font-size: .8rem; font-weight: 600;
  }
  .section-divider::before,
  .section-divider::after { content: ''; flex: 1; height: 1px; background: var(--border); }

  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: #f0f0f0; }
  ::-webkit-scrollbar-thumb { background: #bdbdbd; border-radius: 3px; }

  @media (max-width: 600px) {
    .topbar { padding: 14px 16px; }
    .topbar h1 { font-size: 1rem; }
    .container { padding: 16px 12px; }
    .summary-card .sc-value { font-size: 1.5rem; }
  }


  /* Login inicial */
  .login-screen {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary) 55%, #7986cb 100%);
  }
  body.logged-in .login-screen { display: none; }
  body:not(.logged-in) .topbar,
  body:not(.logged-in) .container,
  body:not(.logged-in) #modalOverlay { display: none !important; }

  .login-card {
    width: 390px;
    max-width: 96vw;
    background: var(--white);
    border-radius: 18px;
    padding: 34px 30px;
    box-shadow: 0 20px 70px rgba(0,0,0,0.25);
    animation: popIn .35s cubic-bezier(0.34,1.56,0.64,1);
  }
  .login-brand { text-align: center; margin-bottom: 24px; }
  .login-brand .brand-icon { font-size: 3rem; margin-bottom: 10px; }
  .login-brand h2 { color: var(--primary-dark); font-size: 1.25rem; margin-bottom: 6px; }
  .login-brand p { color: var(--text-light); font-size: .86rem; line-height: 1.45; }
  .login-field { text-align: left; margin-bottom: 14px; }
  .login-field label { display: block; font-size: .78rem; color: var(--text-light); font-weight: 700; margin-bottom: 6px; text-transform: uppercase; letter-spacing: .4px; }
  .login-field input {
    width: 100%;
    padding: 12px 14px;
    border: 2px solid var(--border);
    border-radius: 9px;
    font-size: .92rem;
    outline: none;
    transition: border .2s, box-shadow .2s;
  }
  .login-field input:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(63,81,181,.12); }
  .login-password-wrap { position: relative; }
  .login-password-wrap input { padding-right: 45px; }
  .login-toggle {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    cursor: pointer;
    user-select: none;
    font-size: 1.05rem;
  }
  #loginError { min-height: 20px; color: var(--red); font-weight: 700; font-size: .82rem; margin: 8px 0 12px; text-align: center; }
  .login-btn { width: 100%; justify-content: center; padding: 12px 20px; }
  .login-help {
    margin-top: 18px;
    padding: 12px 14px;
    border-radius: 10px;
    background: var(--primary-light);
    color: var(--primary-dark);
    font-size: .78rem;
    line-height: 1.55;
  }
  .topbar-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
  .user-badge {
    background: rgba(255,255,255,0.18);
    border: 1px solid rgba(255,255,255,0.35);
    padding: 5px 12px;
    border-radius: 20px;
    font-size: .78rem;
    font-weight: 700;
  }
  .logout-btn {
    background: rgba(255,255,255,0.14);
    border: 1px solid rgba(255,255,255,0.35);
    color: #fff;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: .76rem;
    font-weight: 700;
    cursor: pointer;
    transition: .2s;
  }
  .logout-btn:hover { background: rgba(255,255,255,0.24); }
  .viewer-notice {
    background: #fff8e1;
    border: 1px solid #ffe082;
    color: #6d4c00;
    border-radius: 12px;
    padding: 14px 18px;
    margin-bottom: 20px;
    font-size: .86rem;
    line-height: 1.5;
    box-shadow: var(--shadow);
  }
  .viewer-notice strong { color: #4e3500; }

</style>
</head>
<body>


<div id="loginScreen" class="login-screen">
  <div class="login-card">
    <div class="login-brand">
      <div class="brand-icon">📊</div>
      <h2>Dashboard QA</h2>
      <p>Acesse com seu usuário e senha para visualizar os indicadores de qualidade.</p>
    </div>

    <div class="login-field">
      <label for="loginUser">Usuário</label>
      <input type="text" id="loginUser" placeholder="Digite seu usuário" autocomplete="username">
    </div>

    <div class="login-field">
      <label for="loginPassword">Senha</label>
      <div class="login-password-wrap">
        <input type="password" id="loginPassword" placeholder="Digite sua senha" autocomplete="current-password">
        <span class="login-toggle" id="loginToggle" title="Mostrar/ocultar senha">👁️</span>
      </div>
    </div>

    <div id="loginError"></div>

    <button class="btn btn-primary login-btn" onclick="doLogin()">🔐 Entrar</button>

    <div class="login-help">
      <strong>Permissões:</strong><br>
      Líderes e All: somente visualização.<br>
      QA: visualização + importação/atualização via planilha.
    </div>
  </div>
</div>


<div class="topbar">
  <h1>📊 Dashboard <span>— Controle de Qualidade</span></h1>
  <div class="topbar-actions">
    <div id="periodBadge">📅 —</div>
    <div id="loginUserBadge" class="user-badge">👤 —</div>
    <button class="logout-btn" onclick="logout()">Sair</button>
  </div>
</div>

<div class="modal-overlay" id="modalOverlay">
  <div class="modal">
    <div class="lock-icon">🔐</div>
    <h3>Acesso Restrito</h3>
    <p>Insira a senha QA para processar o arquivo de dados.</p>
    <div id="lockdownMsg">⏳ Muitas tentativas. Aguarde <strong id="cdCount">60</strong>s para tentar novamente.</div>
    <div class="pw-wrap">
      <input type="password" id="pwInput" placeholder="Digite a senha…" autocomplete="off">
      <span class="pw-toggle" id="pwToggle" title="Mostrar/ocultar">👁️</span>
    </div>
    <div id="modalError"></div>
    <div class="attempts-left" id="attemptsLeft"></div>
    <div class="modal-actions">
      <button class="btn-outline" onclick="closeModal()">Cancelar</button>
      <button class="btn btn-primary" onclick="checkPassword()">🔓 Confirmar</button>
    </div>
  </div>
</div>

<div id="toast"></div>

<div class="container">

  <div id="viewerNotice" class="viewer-notice" style="display:none;">👁️ <strong>Acesso de visualização:</strong> você pode consultar o dashboard. A importação/atualização da planilha está liberada apenas para o login <strong>QA</strong>.</div>

  <div id="emptyState">
    <div class="es-icon">📊</div>
    <h3>Nenhum dado carregado</h3>
    <p>Faça o upload de uma planilha <strong>.xlsx</strong> na área abaixo para visualizar o dashboard de controle de qualidade de temperatura.</p>
    <div class="es-arrow">↓</div>
  </div>

  <div id="dashboard">
    <div class="summary-grid" id="summaryGrid"></div>

    <div class="heatmap-card">
      <div class="section-title">🌡️ Conformidade — Setor × Período × Dia</div>
      <div class="heatmap-scroll">
        <table class="heatmap-table" id="heatmapTable"></table>
      </div>
      <div class="heatmap-legend">
        <div class="legend-item"><div class="legend-dot" style="background:#c8e6c9;"></div>Conforme (1)</div>
        <div class="legend-item"><div class="legend-dot" style="background:#ffcdd2;"></div>Não Conforme (0)</div>
        <div class="legend-item"><div class="legend-dot" style="background:#f5f5f5;border:1px solid #e0e0e0;"></div>Sem Registro</div>
      </div>
    </div>

    <div class="main-grid">
      <div class="card">
        <div class="section-title">📊 Conformidade por Setor</div>
        <div id="sectorBars"></div>
        <canvas id="sectorChart"></canvas>
      </div>
      <div class="card">
        <div class="section-title">🕐 Períodos × Não Conformidades</div>
        <table class="period-table" id="periodTable"></table>
        <canvas id="periodChart"></canvas>
      </div>
    </div>

    <div class="bottom-grid">
      <div class="card">
        <div class="section-title">🍚 pH do Arroz</div>
        <div id="phBadge"></div>
        <div class="metric-stats" id="phStats"></div>
        <div class="metric-desc"  id="phDesc"></div>
      </div>
      <div class="card">
        <div class="section-title">🛢️ Saturação do Óleo</div>
        <div id="satBadge"></div>
        <div class="metric-stats" id="satStats"></div>
        <div class="metric-desc"  id="satDesc"></div>
      </div>
    </div>
  </div>

  <div class="section-divider" id="importDivider">📤 Importação de Dados</div>

  <div class="upload-section">
    <div class="upload-card">
      <div class="upload-card-header">
        <h2>📥 Importar Planilha</h2>
        <span class="lock-badge">🔒 Disponível apenas para QA</span>
      </div>
      <div class="drop-zone" id="dropZone" onclick="document.getElementById('fileInput').click()">
        <div class="dz-icon">📂</div>
        <h3>Arraste sua planilha aqui</h3>
        <p>ou clique para selecionar o arquivo</p>
        <button class="btn btn-primary btn-sm" onclick="event.stopPropagation(); document.getElementById('fileInput').click()">
          📎 Selecionar arquivo
        </button>
        <div style="margin-top:10px; font-size:.75rem; color:var(--text-light);">Formatos aceitos: .xlsx · .xls · .csv</div>
      </div>
      <input type="file" id="fileInput" accept=".xlsx,.xls,.csv">
      <div class="file-badge" id="fileBadge">✅ <span id="fileName"></span></div>
      <div class="instructions">
        <h4>📋 Estrutura esperada da planilha</h4>
        <ul>
          <li><strong>Coluna A</strong>: Setor — valores: COZINHA, SUSHIBAR, EXPEDIÇÃO, PEIXARIA, ESTOQUE</li>
          <li><strong>Coluna B</strong>: Período — valores: Abertura, Intermédio, Fechamento</li>
          <li><strong>Colunas C+</strong>: Datas no formato <code>01/jun</code>, <code>02/jun</code>…</li>
          <li><strong>Valores nas células</strong>: <code>1</code> = Aferido/Conforme · <code>0</code> = Não Conforme · <em>vazio</em> = Sem registro</li>
          <li><strong>Aba SATURACAO_OLEO</strong>: mesma lógica — células com <code>1</code> (conforme) ou <code>0</code> (não conforme)</li>
        </ul>
        <div style="margin-top:10px;">
          <div style="font-size:.82rem; color:var(--primary-dark); font-weight:700; margin-bottom:6px;">Abas reconhecidas:</div>
          <div class="aba-list">
            <span class="aba-chip">CONTROLE_TEMPERATURA</span>
            <span class="aba-chip">PH_ARROZ</span>
            <span class="aba-chip">SATURACAO_OLEO</span>
            <span class="aba-chip">RESUMO</span>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>

<script>

// ══════════════════════════════════════════════════════════════
//  Controle de acesso por perfil
//  Observação: em site estático, isso bloqueia a interface, mas não
//  substitui autenticação real de servidor para dados sensíveis.
// ══════════════════════════════════════════════════════════════
const AUTH_KEY = 'dashboardQAAuth';
const LOGIN_USERS = [
  { username: 'lideres', password: 'qwe123!@',     role: 'viewer', label: 'Líderes' },
  { username: 'all',     password: 'BOT.qa12345',  role: 'viewer', label: 'All' },
  { username: 'QA',      password: 'QA.Bot2026',   role: 'qa',     label: 'QA' }
];
let currentUser = null;

function findLoginUser(username, password) {
  const cleanUser = String(username || '').trim().toLowerCase();
  return LOGIN_USERS.find(u =>
    u.username.toLowerCase() === cleanUser && u.password === String(password || '')
  ) || null;
}

function doLogin() {
  const user = document.getElementById('loginUser').value;
  const pass = document.getElementById('loginPassword').value;
  const found = findLoginUser(user, pass);

  if (!found) {
    document.getElementById('loginError').textContent = '❌ Usuário ou senha inválidos.';
    document.getElementById('loginPassword').value = '';
    document.getElementById('loginPassword').focus();
    return;
  }

  const safeUser = { username: found.username, role: found.role, label: found.label };
  sessionStorage.setItem(AUTH_KEY, JSON.stringify(safeUser));
  applyAuth(safeUser);
}

function applyAuth(user) {
  currentUser = user;
  document.body.classList.add('logged-in');

  const badge = document.getElementById('loginUserBadge');
  if (badge) badge.textContent = `👤 ${user.label}`;

  const canUpdate = user.role === 'qa';
  const upload = document.querySelector('.upload-section');
  const divider = document.getElementById('importDivider');
  const viewerNotice = document.getElementById('viewerNotice');

  if (upload) upload.style.display = canUpdate ? '' : 'none';
  if (divider) divider.style.display = canUpdate ? '' : 'none';
  if (viewerNotice) viewerNotice.style.display = canUpdate ? 'none' : 'block';
}

function logout() {
  sessionStorage.removeItem(AUTH_KEY);
  currentUser = null;
  document.body.classList.remove('logged-in');
  document.getElementById('loginUser').value = '';
  document.getElementById('loginPassword').value = '';
  document.getElementById('loginError').textContent = '';
  setTimeout(() => document.getElementById('loginUser').focus(), 100);
}

function initAuth() {
  try {
    const saved = JSON.parse(sessionStorage.getItem(AUTH_KEY) || 'null');
    if (saved && LOGIN_USERS.some(u => u.username === saved.username && u.role === saved.role)) {
      applyAuth(saved);
    } else {
      document.getElementById('loginUser').focus();
    }
  } catch(e) {
    sessionStorage.removeItem(AUTH_KEY);
    document.getElementById('loginUser').focus();
  }

  document.getElementById('loginToggle').addEventListener('click', () => {
    const inp = document.getElementById('loginPassword');
    inp.type = inp.type === 'password' ? 'text' : 'password';
  });

  ['loginUser', 'loginPassword'].forEach(id => {
    document.getElementById(id).addEventListener('keydown', e => {
      if (e.key === 'Enter') doLogin();
    });
  });
}

let pendingFile = null;
let attempts    = 0;
const MAX_ATTEMPTS = 5;
const CORRECT_PW   = 'QA.Bot2026';
let lockdownTimer  = null;
let chartSector    = null;
let chartPeriod    = null;

const dropZone  = document.getElementById('dropZone');
const fileInput = document.getElementById('fileInput');

dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('dragover'); });
dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
dropZone.addEventListener('drop', e => {
  e.preventDefault();
  dropZone.classList.remove('dragover');
  const f = e.dataTransfer.files[0];
  if (f) handleFileSelected(f);
});
fileInput.addEventListener('change', () => {
  if (fileInput.files[0]) handleFileSelected(fileInput.files[0]);
});

function handleFileSelected(file) {
  if (!currentUser || currentUser.role !== 'qa') {
    showToast('🔒 Apenas o login QA pode importar/atualizar a planilha.', 'error', 4500);
    fileInput.value = '';
    return;
  }

  pendingFile = file;
  document.getElementById('fileName').textContent = file.name;
  document.getElementById('fileBadge').classList.add('show');

  // Como o usuário QA já autenticou no login inicial, a planilha é processada direto.
  processFile(pendingFile);
}

function openModal() {
  document.getElementById('pwInput').value = '';
  document.getElementById('modalError').textContent = '';
  document.getElementById('attemptsLeft').textContent = '';
  document.getElementById('modalOverlay').classList.add('show');
  setTimeout(() => document.getElementById('pwInput').focus(), 300);
}
function closeModal() {
  document.getElementById('modalOverlay').classList.remove('show');
}

document.getElementById('pwToggle').addEventListener('click', () => {
  const inp = document.getElementById('pwInput');
  inp.type  = inp.type === 'password' ? 'text' : 'password';
});
document.getElementById('pwInput').addEventListener('keydown', e => {
  if (e.key === 'Enter') checkPassword();
});

function checkPassword() {
  if (lockdownTimer) return;
  const val = document.getElementById('pwInput').value;
  if (val === CORRECT_PW) {
    attempts = 0;
    closeModal();
    processFile(pendingFile);
  } else {
    attempts++;
    document.getElementById('pwInput').value = '';
    const left = MAX_ATTEMPTS - attempts;
    if (attempts >= MAX_ATTEMPTS) {
      startLockdown();
    } else {
      document.getElementById('modalError').textContent   = '❌ Senha incorreta.';
      document.getElementById('attemptsLeft').textContent = `Tentativas restantes: ${left}`;
    }
  }
}

function startLockdown() {
  let secs = 60;
  document.getElementById('lockdownMsg').style.display = 'block';
  document.getElementById('pwInput').disabled = true;
  document.getElementById('modalError').textContent    = '';
  document.getElementById('attemptsLeft').textContent  = '';
  document.getElementById('cdCount').textContent = secs;
  lockdownTimer = setInterval(() => {
    secs--;
    document.getElementById('cdCount').textContent = secs;
    if (secs <= 0) {
      clearInterval(lockdownTimer);
      lockdownTimer = null;
      attempts = 0;
      document.getElementById('lockdownMsg').style.display = 'none';
      document.getElementById('pwInput').disabled = false;
      document.getElementById('pwInput').focus();
    }
  }, 1000);
}

function showToast(msg, type = 'info', duration = 3000) {
  const t = document.getElementById('toast');
  const colors = { info: '#5c6bc0', success: '#43a047', error: '#e53935', warning: '#fb8c00' };
  t.style.background = colors[type] || colors.info;
  t.textContent = msg;
  t.style.display = 'block';
  clearTimeout(t._timer);
  t._timer = setTimeout(() => { t.style.display = 'none'; }, duration);
}

function processFile(file) {
  showToast('⏳ Processando arquivo…', 'info', 6000);
  const reader = new FileReader();
  reader.onload = e => {
    try {
      const data   = new Uint8Array(e.target.result);
      const wb     = XLSX.read(data, { type: 'array' });
      const parsed = parseWorkbook(wb, file.name);
      renderDashboard(parsed);
      showToast('✅ Dashboard atualizado com sucesso!', 'success');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } catch(err) {
      console.error(err);
      showToast('❌ Erro ao processar o arquivo: ' + err.message, 'error', 5000);
    }
  };
  reader.onerror = () => showToast('❌ Erro ao ler o arquivo.', 'error');
  reader.readAsArrayBuffer(file);
}

// ══════════════════════════════════════════════════════════════
//  Lê QUALQUER aba contando células 1 (conforme) e 0 (não conf.)
//  Ignora células vazias, strings de cabeçalho, etc.
//  Retorna { ok, fail, total, pct } ou null se aba não existir.
// ══════════════════════════════════════════════════════════════
function parseConformanceSheet(sheet) {
  if (!sheet) return null;

  // Lê como array de arrays para varrer todas as células sem depender de cabeçalho
  const rows = XLSX.utils.sheet_to_json(sheet, { header: 1, defval: '' });

  let ok = 0, fail = 0;

  for (const row of rows) {
    for (const cell of row) {
      // Ignora vazios e strings (cabeçalhos, rótulos, etc.)
      if (cell === '' || cell === null || cell === undefined) continue;
      const n = Number(cell);
      if (isNaN(n)) continue; // pula textos
      if (n === 1) ok++;
      else if (n === 0) fail++;
      // outros números (ex: datas serializadas) são ignorados
    }
  }

  const total = ok + fail;
  const pct   = total > 0 ? parseFloat(((ok / total) * 100).toFixed(1)) : null;
  return { ok, fail, total, pct };
}

function parseWorkbook(wb, filename) {
  // ── Aba principal ──
  const mainNames = ['CONTROLE_TEMPERATURA','CONTROLE','TEMPERATURA','REGISTRO','DADOS'];
  let mainSheet = null;
  for (const n of mainNames) {
    const found = wb.SheetNames.find(s => s.toUpperCase().includes(n));
    if (found) { mainSheet = wb.Sheets[found]; break; }
  }
  if (!mainSheet) mainSheet = wb.Sheets[wb.SheetNames[0]];

  const rows = XLSX.utils.sheet_to_json(mainSheet, { header: 1, defval: '' });

  let headerRowIdx = 0;
  for (let i = 0; i < Math.min(5, rows.length); i++) {
    if (rows[i].some(c => /\d{1,2}\/[a-zA-Záéíóú]{3}/i.test(String(c)))) {
      headerRowIdx = i; break;
    }
  }
  const header = rows[headerRowIdx];

  const days = [];
  for (let c = 2; c < header.length; c++) {
    const val = String(header[c]).trim();
    if (val) days.push({ col: c, label: val });
  }

  const period = detectPeriod(filename, days);

  const setorOrder  = ['COZINHA','SUSHIBAR','EXPEDIÇÃO','PEIXARIA','ESTOQUE'];
  const periodOrder = ['Abertura','Intermédio','Fechamento'];
  const estrutura   = {};
  const detectedSetors  = new Set();
  const detectedPeriods = new Set();

  for (let r = headerRowIdx + 1; r < rows.length; r++) {
    const row    = rows[r];
    const setor  = String(row[0] || '').trim().toUpperCase();
    const periodo= String(row[1] || '').trim();
    if (!setor || !periodo) continue;
    const setorKey = normalizeSetor(setor);
    if (!setorKey) continue;
    detectedSetors.add(setorKey);
    detectedPeriods.add(periodo);
    if (!estrutura[setorKey])          estrutura[setorKey] = {};
    if (!estrutura[setorKey][periodo]) estrutura[setorKey][periodo] = {};
    for (const { col, label } of days) {
      const raw = row[col];
      const val = (raw === '' || raw === undefined || raw === null)
                  ? null
                  : (Number(raw) === 1 ? 1 : Number(raw) === 0 ? 0 : null);
      estrutura[setorKey][periodo][label] = val;
    }
  }

  const setors   = setorOrder.filter(s => detectedSetors.has(s));
  if (!setors.length) detectedSetors.forEach(s => setors.push(s));
  const periodos = periodOrder.filter(p => detectedPeriods.has(p));
  if (!periodos.length) detectedPeriods.forEach(p => periodos.push(p));

  // ── Stats aba principal ──
  let totalOk = 0, totalFail = 0, totalReg = 0;
  const sectorStats  = {};
  const periodoStats = {};

  for (const s of setors) {
    sectorStats[s] = { ok: 0, fail: 0, total: 0 };
    for (const p of periodos) {
      if (!periodoStats[p]) periodoStats[p] = { ok: 0, fail: 0 };
      const dayData = estrutura[s]?.[p] || {};
      for (const { label } of days) {
        const v = dayData[label];
        if (v === 1) {
          totalOk++; totalReg++;
          sectorStats[s].ok++; sectorStats[s].total++;
          periodoStats[p].ok++;
        } else if (v === 0) {
          totalFail++; totalReg++;
          sectorStats[s].fail++; sectorStats[s].total++;
          periodoStats[p].fail++;
        }
      }
    }
  }

  // ── PH_ARROZ: lê células 1/0 ──
  const phSheetName = wb.SheetNames.find(n => n.toUpperCase().includes('PH'));
  const phData      = parseConformanceSheet(phSheetName ? wb.Sheets[phSheetName] : null);

  // ── SATURACAO_OLEO: lê células 1/0 (mesma lógica) ──
  const satSheetName = wb.SheetNames.find(n =>
    n.toUpperCase().includes('SATURA') ||
    n.toUpperCase().includes('OLEO')   ||
    n.toUpperCase().includes('ÓLEO')
  );
  const satData = parseConformanceSheet(satSheetName ? wb.Sheets[satSheetName] : null);

  return {
    period, days, setors, periodos, estrutura,
    totalOk, totalFail, totalReg,
    sectorStats, periodoStats,
    phData, satData
  };
}

function normalizeSetor(s) {
  const map = {
    'COZINHA':'COZINHA','SUSHIBAR':'SUSHIBAR','SUSHI BAR':'SUSHIBAR','SUSHI':'SUSHIBAR',
    'EXPEDIÇÃO':'EXPEDIÇÃO','EXPEDICAO':'EXPEDIÇÃO','PEIXARIA':'PEIXARIA','ESTOQUE':'ESTOQUE'
  };
  return map[s] || (s || null);
}

function detectPeriod(filename, days) {
  const months = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
  const fnLow  = filename.toLowerCase();
  for (const m of months) {
    if (fnLow.includes(m)) return m.charAt(0).toUpperCase() + m.slice(1) + '/' + new Date().getFullYear();
  }
  if (days.length > 0) {
    const parts = days[0].label.split('/');
    if (parts[1]) return parts[1].charAt(0).toUpperCase() + parts[1].slice(1) + '/' + new Date().getFullYear();
  }
  return 'Período atual';
}

function conformColor(pct) {
  if (pct === 100) return '#4caf50';
  if (pct >= 90)   return '#8bc34a';
  if (pct >= 75)   return '#ff9800';
  return '#f44336';
}

function getSectorPairsSorted(d) {
  return d.setors.map(s => {
    const st  = d.sectorStats[s];
    const pct = st.total > 0 ? parseFloat(((st.ok / st.total) * 100).toFixed(1)) : 0;
    return { setor: s, pct, ok: st.ok, total: st.total };
  }).sort((a, b) => b.pct - a.pct);
}

function renderDashboard(d) {
  document.getElementById('emptyState').style.display = 'none';
  document.getElementById('dashboard').style.display  = 'block';
  const pb = document.getElementById('periodBadge');
  pb.textContent   = '📅 ' + d.period;
  pb.style.display = 'inline-block';

  renderSummary(d);
  renderHeatmap(d);
  renderSectorBars(d);
  renderSectorChart(d);
  renderPeriodTable(d);
  renderPeriodChart(d);
  renderMetrics(d);
}

function renderSummary(d) {
  const conformPct = d.totalReg > 0 ? ((d.totalOk / d.totalReg) * 100).toFixed(1) : '—';
  const cpNum      = parseFloat(conformPct);
  const cpColor    = isNaN(cpNum) ? '#3f51b5' : cpNum >= 90 ? '#4caf50' : cpNum >= 60 ? '#ff9800' : '#f44336';
  const cards = [
    { label: 'Setores Monitorados', value: d.setors.length,  sub: d.setors.join(', '), color: '#3f51b5' },
    { label: 'Conformidade Geral',  value: conformPct + (d.totalReg > 0 ? '%' : ''), sub: `${d.totalOk} de ${d.totalReg} registros`, color: cpColor },
    { label: 'Não Conformidades',   value: d.totalFail, sub: 'ocorrências no período', color: '#f44336' },
    { label: 'Total de Registros',  value: d.totalReg,  sub: 'células com valor', color: '#5c6bc0' },
    { label: 'Dias no Período',     value: d.days.length, sub: d.days.length > 0 ? `${d.days[0].label} → ${d.days[d.days.length-1].label}` : '—', color: '#26a69a' },
  ];
  document.getElementById('summaryGrid').innerHTML = cards.map(c => `
    <div class="summary-card" style="border-top-color:${c.color}">
      <div class="sc-label">${c.label}</div>
      <div class="sc-value" style="color:${c.color}">${c.value}</div>
      <div class="sc-sub">${c.sub}</div>
    </div>`).join('');
}

function renderHeatmap(d) {
  const tbl = document.getElementById('heatmapTable');
  let html  = '<thead><tr>';
  html += `<th class="th-setor">Setor</th><th class="th-periodo">Período</th>`;
  for (const day of d.days) html += `<th class="th-day">${day.label}</th>`;
  html += '</tr></thead><tbody>';
  for (const setor of d.setors) {
    html += `<tr class="setor-header"><td colspan="${2 + d.days.length}">🏷️ ${setor}</td></tr>`;
    for (const periodo of d.periodos) {
      const dayData = d.estrutura[setor]?.[periodo] || {};
      html += `<tr class="data-row"><td></td><td class="td-periodo">${periodo}</td>`;
      for (const { label } of d.days) {
        const v = dayData[label];
        if      (v === 1) html += `<td class="cell-ok"    title="${setor} · ${periodo} · ${label}: Conforme">✓</td>`;
        else if (v === 0) html += `<td class="cell-fail"  title="${setor} · ${periodo} · ${label}: Não Conforme">✗</td>`;
        else              html += `<td class="cell-empty" title="${setor} · ${periodo} · ${label}: Sem registro">·</td>`;
      }
      html += '</tr>';
    }
  }
  tbl.innerHTML = html + '</tbody>';
}

function renderSectorBars(d) {
  const pairs = getSectorPairsSorted(d);
  document.getElementById('sectorBars').innerHTML = pairs.map(({ setor, pct, ok, total }) => {
    const col = conformColor(pct);
    return `
      <div class="sector-bar-item">
        <div class="sector-bar-label">
          <span>${setor}</span>
          <span style="color:${col};font-weight:800">${pct}%
            <span style="color:var(--text-light);font-weight:400">(${ok}/${total})</span>
          </span>
        </div>
        <div class="bar-track">
          <div class="bar-fill" style="width:${pct}%;background:${col}"></div>
        </div>
      </div>`;
  }).join('');
}

function renderSectorChart(d) {
  if (chartSector) { chartSector.destroy(); chartSector = null; }
  const pairs = getSectorPairsSorted(d);
  chartSector = new Chart(document.getElementById('sectorChart').getContext('2d'), {
    type: 'bar',
    data: {
      labels: pairs.map(p => p.setor),
      datasets: [{
        label: 'Conformidade (%)',
        data: pairs.map(p => p.pct),
        backgroundColor: pairs.map(p => conformColor(p.pct)),
        borderRadius: 6,
        borderSkipped: false,
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: {
            label: ctx => `${ctx.raw}%  (${pairs[ctx.dataIndex].ok}/${pairs[ctx.dataIndex].total} registros)`
          }
        }
      },
      scales: {
        y: { min: 0, max: 100, ticks: { callback: v => v + '%' }, grid: { color: '#f0f0f0' } },
        x: { grid: { display: false } }
      }
    }
  });
}

function renderPeriodTable(d) {
  const tbl = document.getElementById('periodTable');
  let html  = '<thead><tr><th>Período</th><th>Não Realizados</th><th>% NC</th></tr></thead><tbody>';
  for (const p of d.periodos) {
    const ps    = d.periodoStats[p] || { ok: 0, fail: 0 };
    const total = ps.ok + ps.fail;
    const ncPct = total > 0 ? ((ps.fail / total) * 100).toFixed(1) : '0.0';
    const col   = ncPct < 10 ? '#4caf50' : ncPct < 30 ? '#ff9800' : '#f44336';
    html += `<tr>
      <td><span class="dot" style="background:${col}"></span>${p}</td>
      <td><strong>${ps.fail}</strong></td>
      <td style="color:${col};font-weight:700">${ncPct}%</td>
    </tr>`;
  }
  tbl.innerHTML = html + '</tbody>';
}

function renderPeriodChart(d) {
  if (chartPeriod) { chartPeriod.destroy(); chartPeriod = null; }
  chartPeriod = new Chart(document.getElementById('periodChart').getContext('2d'), {
    type: 'doughnut',
    data: {
      labels: d.periodos,
      datasets: [{
        data: d.periodos.map(p => (d.periodoStats[p] || { fail: 0 }).fail),
        backgroundColor: ['#ef5350','#ff9800','#42a5f5','#ab47bc','#26c6da'],
        borderWidth: 2,
        borderColor: '#fff',
      }]
    },
    options: {
      responsive: true, cutout: '65%',
      plugins: {
        legend: { position: 'bottom', labels: { font: { size: 11 }, padding: 12 } },
        tooltip: { callbacks: { label: c => `${c.label}: ${c.raw} não conformidades` } }
      }
    }
  });
}

// ── Renderiza card de métrica (pH e Saturação) com contagem real ──
function renderMetricCard({ badgeEl, statsEl, descEl, emoji, data, label, noDataMsg }) {
  if (!data || data.pct === null) {
    document.getElementById(badgeEl).innerHTML  = `<span class="metric-badge" style="background:#f5f5f5;color:#757575">${emoji} N/D</span>`;
    document.getElementById(statsEl).textContent = '';
    document.getElementById(descEl).innerHTML   = noDataMsg;
    document.getElementById(descEl).style.color = '#757575';
    return;
  }

  const { ok, fail, total, pct } = data;
  const col = conformColor(pct);
  const cls = pct === 100 ? 'badge-green' : pct >= 75 ? 'badge-orange' : 'badge-red';
  const ico = pct === 100 ? '✅' : pct >= 75 ? '⚠️' : '❌';

  document.getElementById(badgeEl).innerHTML =
    `<span class="metric-badge ${cls}" style="color:${col}">${emoji} ${pct.toFixed(1)}%</span>`;

  document.getElementById(statsEl).innerHTML =
    `<strong>${ok}</strong> conforme${ok !== 1 ? 's' : ''} · 
     <strong>${fail}</strong> não conforme${fail !== 1 ? 's' : ''} · 
     <strong>${total}</strong> total`;

  const msg = pct === 100
    ? `${ico} ${label} com 100% de conformidade — perfeito!`
    : `${ico} ${label} com ${pct.toFixed(1)}% de conformidade. O ideal é 100%.`;

  document.getElementById(descEl).innerHTML   = msg;
  document.getElementById(descEl).style.color = col;
}

function renderMetrics(d) {
  renderMetricCard({
    badgeEl: 'phBadge',
    statsEl: 'phStats',
    descEl:  'phDesc',
    emoji:   '🍚',
    data:    d.phData,
    label:   'pH do arroz',
    noDataMsg: 'Dados de pH do arroz não encontrados.<br>Adicione uma aba chamada <strong>PH_ARROZ</strong> com células <code>1</code> (conforme) ou <code>0</code> (não conforme).'
  });

  renderMetricCard({
    badgeEl: 'satBadge',
    statsEl: 'satStats',
    descEl:  'satDesc',
    emoji:   '🛢️',
    data:    d.satData,
    label:   'Saturação do óleo',
    noDataMsg: 'Dados de saturação não encontrados.<br>Adicione uma aba chamada <strong>SATURACAO_OLEO</strong> com células <code>1</code> (conforme) ou <code>0</code> (não conforme).'
  });
}

initAuth();
</script>
